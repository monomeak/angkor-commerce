{
    "name": "angkor-commerce",
    "private": true,
    "packageManager": "pnpm@10.24.0",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "start": "turbo start",
        "dev:back-office": "turbo dev --filter=back-office-portal -- --port 4000",
        "build:back-office": "turbo build --filter=back-office-portal",
        "start:back-office": "turbo start --filter=back-office-portal",
        "dev:customer-portal": "turbo dev --filter=customer-portal",
        "build:customer-portal": "turbo build --filter=customer-portal",
        "start:customer-portal": "turbo start --filter=customer-portal",
        "lint:back-office": "turbo lint --filter=back-office-portal"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-java": "^2.10.3",
        "turbo": "^2.10.5"
    },
    "dependencies": {
        "next-themes": "^0.4.6"
    }
}
